# Copy to .env with `yarn demo:env:init`, which generates random values.
# Never commit .env. Values below are placeholders/explanations only.

# Postgres password for the local backstage database (docker-compose + backend).
POSTGRES_PASSWORD=

# Secret for the auth backend's session cookie (OIDC sign-in flow).
AUTH_SESSION_SECRET=

# Shared secret between Dex and Backstage for the "backstage" OIDC client.
DEX_BACKSTAGE_CLIENT_SECRET=

# Synthetic user passwords for the local Dex identity provider, and the bcrypt
# hashes Dex loads (hashFromEnv). The scripted browser sign-in reads the
# plaintext from here; it is never logged or written to evidence.
DEMO_ALICE_PASSWORD=
DEMO_ALICE_PASSWORD_HASH=
DEMO_BOB_PASSWORD=
DEMO_BOB_PASSWORD_HASH=
DEMO_CAROL_PASSWORD=
DEMO_CAROL_PASSWORD_HASH=
# Demo service account for the MIG-42 agent (act 3).
DEMO_MIG42_AGENT_PASSWORD=
DEMO_MIG42_AGENT_PASSWORD_HASH=

# Static external-access token for the operator CLI. Restricted in
# app-config.yaml to the retirement-demo plugin only.
DEMO_OPERATOR_TOKEN=

# Static external-access token for the retirement plugin's privileged executor.
# Restricted in app-config.yaml to the catalog plugin and to
# catalog.entity.read / catalog.location.read / .create / .delete.
DEMO_EXECUTOR_TOKEN=

# Workload probe used only by `yarn demo:findings` (restricted to the MCP and
# retirement-demo plugins; rejected as a caller by the retirement action).
DEMO_PROBE_SERVICE_TOKEN=

# Live model run (yarn demo:live): Nebius Token Factory API key. Optional;
# the deterministic replay does not need it. NEBIUS_BASE_URL defaults to
# https://api.tokenfactory.nebius.com/v1.
NEBIUS_API_KEY=

# Do NOT set this here. `yarn demo:start:ungated` sets DEMO_LAB_ENABLED=true for
# that process only; without it the ungated profile refuses to start.
# DEMO_LAB_ENABLED=
